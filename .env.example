# Required
NOTION_TOKEN=

# Optional Notion
NOTION_DATABASE_ID=16f9d45a816849cf9436ed2a566312b3
NOTION_VERSION=2022-06-28

# Billing month override (default: previous calendar month in America/Los_Angeles)
# BILLING_MONTH=2026-09

# Output (local when GCS_BUCKET unset)
OUTPUT_DIR=./output

# GCS (optional — example bucket used by sibling services in work-projects-486912)
GCS_BUCKET=trimble-data-bucket-rk
GCS_PREFIX=notion-drone-billing-report/

# Email (sent only after Notion query, month filter, Excel, validation, and GCS if enabled)
REPORT_EMAIL_TO=rkolt@sukut.com
REPORT_EMAIL_CC=meklund@sukut.com
REPORT_EMAIL_ENABLED=true
# Do not commit real credentials. Cloud Run maps these from Secret Manager.
# Local: set them here, or use REPORT_EMAIL_ENABLED=false to skip sending.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Aliases accepted: SMTP_USER, SMTP_PASS, SMTP_HOST, SMTP_PORT, EMAIL_FROM
# Defaults: smtp.gmail.com:587 STARTTLS
